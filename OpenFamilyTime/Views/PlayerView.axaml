<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFamilyTime.Views.PlayerView"
             xmlns:vm="using:OpenFamilyTime.ViewModels"
             x:DataType="vm:PlayerViewModel"
             xmlns:vlc="using:LibVLCSharp.Avalonia">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Player" FontSize="20" FontWeight="Bold" />
        <vlc:VideoView MediaPlayer="{Binding Player}" Height="300"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Pause" Command="{Binding PauseCommand}"/>
            <Button Content="Stop" Command="{Binding StopCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
