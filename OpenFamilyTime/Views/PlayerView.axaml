<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFamilyTime.Views.PlayerView"
             xmlns:vm="using:OpenFamilyTime.ViewModels"
             x:DataType="vm:PlayerViewModel">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Player" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <Button Content="Open in browser" Command="{Binding OpenExternalCommand}" />
        <TextBlock Text="VLC embedded come next (LibVLCSharp). This proves wiring first." Opacity="0.6"/>
    </StackPanel>
</UserControl>
