<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenFamilyTime.Views.DetailsView"
             xmlns:vm="using:OpenFamilyTime.ViewModels"
             x:DataType="vm:DetailsViewModel">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="{Binding Details.Title}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Details.Plot}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Bookmark" Command="{Binding BookMarkCommand}"/>
            <TextBlock Text="{Binding BookmarkStatus}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Sources" FontWeight="Bold" />
        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Quality}" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
